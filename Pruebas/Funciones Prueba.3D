saludar:
mostrar "Iniciando programa de prueba...";
sumar:
t1=a+b;
resultado=t1;
retornar resultado;
principal:
call saludar, 0;
x=10;
y=5;
param x;
param y;
t2 = call sumar, 2;
total=t2;
mostrar "El total es: ";
mostrar total;
IF total>10 goto L2
goto L3;
