calcularFactorial:
recibir numero;
resultado_fact=1;
temp=numero;
L1:
IF temp>1 goto L2
goto L3;
L2:
t1=resultado_fact*temp;
resultado_fact=t1;
t2=temp-1;
temp=t2;
goto L1;
L3:
retornar resultado_fact;
principal:
opcion=0;
valor1=0;
valor2=0;
stop=0;
resultado=0;
L4:
IF opcion!=5 goto L5
goto L6;
L5:
mostrar "==============================";
mostrar "   CALCULADORA MULTIPROPOSITO ";
mostrar "==============================";
mostrar "1. Operacion Simple (Suma)";
mostrar "2. Operacion Compleja (Division Segura)";
mostrar "3. Ciclo Anidado (Tabla de Multiplicar)";
mostrar "4. Operacion con Funcion (Factorial)";
mostrar "5. Salir";
mostrar "==============================";
mostrar "Seleccione una opcion: ";
leer opcion;
IF opcion==1 goto L8
IF opcion==2 goto L9
IF opcion==3 goto L10
IF opcion==4 goto L11
IF opcion==5 goto L12
goto L13;
L8:
mostrar "Ingrese primer numero: ";
leer valor1;
mostrar "Ingrese segundo numero: ";
leer valor2;
t3=valor1+valor2;
resultado=t3;
mostrar "El resultado de la suma es: ";
mostrar resultado;
goto L7;
L9:
mostrar "Ingrese el dividendo: ";
leer valor1;
mostrar "Ingrese el divisor (No puede ser cero): ";
leer valor2;
IF valor2==0 goto L15
goto L16;
L15:
mostrar "-> ERROR: No se puede dividir entre cero.";
goto L14;
L16:
t4=valor1/valor2;
resultado=t4;
mostrar "El resultado de la division es: ";
mostrar resultado;
L14:
goto L7;
L10:
mostrar "Ingrese un numero para ver su tabla: ";
leer valor1;
mostrar "Generando tabla...";
i=1;
L17:
IF i<=10 goto L18
goto L20;
L18:
t5=valor1*i;
resultado=t5;
mostrar valor1;
mostrar " x ";
mostrar i;
mostrar " = ";
mostrar resultado;
L19:
t6=i+1;
i=t6;
goto L17;
L20:
goto L7;
L11:
mostrar "Ingrese un numero para calcular su factorial: ";
leer valor1;
param valor1;
t7 = call calcularFactorial, 1;
resultado=t7;
mostrar "El factorial es: ";
mostrar resultado;
goto L7;
L12:
mostrar "Saliendo de la calculadora...";
goto L7;
L13:
mostrar "-> ERROR: Opcion invalida. Intente de nuevo.";
goto L7;
L7:
mostrar "";
goto L4;
L6:
