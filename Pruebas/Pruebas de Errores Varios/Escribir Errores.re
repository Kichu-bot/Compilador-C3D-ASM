    // 1. Falta punto y coma
    escribirLinea("Falta punto y coma")

    // 2. Falta paréntesis final
    escribirLinea("Falta parentesis final" ;

    // 3. Falta paréntesis inicial
    escribirLinea "Falta parentesis inicial" );

    // 4. Faltan ambos
